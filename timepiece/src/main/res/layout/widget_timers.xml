<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wd_widget_bg" android:padding="10dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Timers" android:textSize="12sp" android:textStyle="bold" android:textColor="#FF6B7078" android:maxLines="1" android:ellipsize="end"/>
        <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF1B1D21" android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_b0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="40dp" android:layout_margin="3dp" android:background="@drawable/wd_key_op" android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:textColor="#FF173A66"/>
        <TextView android:id="@+id/w_b1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="40dp" android:layout_margin="3dp" android:background="@drawable/wd_key_op" android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:textColor="#FF173A66"/>
        <TextView android:id="@+id/w_b2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="40dp" android:layout_margin="3dp" android:background="@drawable/wd_key_op" android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:textColor="#FF173A66"/>
        <TextView android:id="@+id/w_b3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="40dp" android:layout_margin="3dp" android:background="@drawable/wd_btn_gel" android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
    </LinearLayout>
</LinearLayout>
